{
  "name": "chuncheon-gating",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "node scripts/test-db.mjs",
    "test:db:resilience": "node scripts/test-db-resilience.mjs",
    "test:integration:local": "node scripts/test-supabase-local.mjs",
    "test:production": "node scripts/smoke-production.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "test:e2e": "playwright test",
    "test:e2e:webkit": "CC_TEST_API_ORIGIN=http://127.0.0.1:5181 playwright test --config=playwright.webkit.config.ts",
    "test:installed-upgrade": "node scripts/test-installed-upgrade.mjs",
    "build:native": "tsc --noEmit && node scripts/build-native.mjs",
    "mobile:sync": "npm run build:native && cap sync",
    "mobile:android": "cap open android",
    "mobile:ios": "cap open ios",
    "mobile:icons": "capacitor-assets generate --assetPath assets --ios --android",
    "mobile:android:key": "node scripts/android-upload-key.mjs",
    "mobile:android:bundle": "node scripts/build-android-release.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.6.2",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.2",
    "@capacitor/ios": "8.6.2",
    "@supabase/supabase-js": "2.105.1",
    "lucide-react": "0.451.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@capacitor/assets": "4.0.0",
    "@capacitor/cli": "8.6.2",
    "@playwright/test": "1.58.2",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.20.4",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "jsdom": "26.1.0",
    "postcss": "8.5.28",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "6.4.6",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "overrides": {
    "source-map-js": "1.2.2"
  }
}
