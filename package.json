    "@types/node": "22.20.4",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.5.0",
    "jsdom": "26.1.0",
    "postcss": "8.5.28",
    "tailwindcss": "3.4.19",
